DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Phase 4 local-first storage. SQLite is the default; path is optional.
JIANYUAN_STORAGE="sqlite"
JIANYUAN_SQLITE_PATH=".jianyuan/jianyuan.sqlite"

# Phase 5 AI Provider. Disabled unless explicitly set to true.
JIANYUAN_AI_ENABLED="false"
JIANYUAN_AI_PROVIDER="openai-compatible"
JIANYUAN_AI_BASE_URL="https://api.example.com/v1"
JIANYUAN_AI_API_KEY=""
JIANYUAN_AI_MODEL=""
JIANYUAN_AI_TIMEOUT_MS="30000"

# Formal local-first composition (default values shown)
JIANYUAN_STORAGE="sqlite"
JIANYUAN_SQLITE_PATH=".jianyuan/jianyuan.sqlite"

# AI is opt-in. Leave disabled to guarantee no personal context is sent.
JIANYUAN_AI_ENABLED="false"
JIANYUAN_AI_PROVIDER="openai-compatible"
JIANYUAN_AI_BASE_URL=""
JIANYUAN_AI_API_KEY=""
JIANYUAN_AI_MODEL=""
JIANYUAN_AI_TIMEOUT_MS="30000"
